## Do not modify this file, create a new policy with with a lower number in the
## file name instead. For example `30-user.policy`.
qusal.MailFetch   * @tag:mail-fetcher @tag:mail-reader ask
qusal.MailFetch   * @tag:mail-fetcher @default ask default_target=mail-reader
qusal.MailFetch   * @anyvm @anyvm deny

qusal.MailEnqueue * @tag:mail-reader @tag:mail-sender ask
qusal.MailEnqueue * @tag:mail-reader @default ask
qusal.MailEnqueue * @anyvm @anyvm deny

qusal.MailToken   * @tag:mail-fetcher @default allow target=mail-token
qusal.MailToken   * @tag:mail-sender  @default allow target=mail-token
## Disposable templates carry no tag, allow them to test the configuration.
qusal.MailToken   * dvm-mail-fetcher  @default allow target=mail-token
qusal.MailToken   * dvm-mail-sender   @default allow target=mail-token
qusal.MailToken   * @anyvm @anyvm deny
## vim:ft=qrexecpolicy
