## OAuth2 variant. The refresh token stays in the 'mail-token' qube, this
## qube only ever sees short lived access tokens.

##### DO NOT EDIT THIS BLOCK #####
defaults
  auth on
  tls on
  tls_starttls off
  tls_trust_file system
  logfile ~/log/msmtp.log

account main
  auth xoauth2
  passwordeval qusal-mail-token

##### EDIT THIS BLOCK #####
  host smtp.gmail.com
  port 465
  user john-doe@gmail.com
  from john-doe@gmail.com

##### DO NOT EDIT THIS BLOCK #####
account default : main
