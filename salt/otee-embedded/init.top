base:
  'dom0':
    - match: nodegroup
    - otee-embedded.create
  'tpl-otee-embedded':
    - otee-embedded.install
  'dvm-otee-embedded':
    - otee-embedded.configure-dvm
  'otee-embedded':
    - otee-embedded.configure
  '(I@qubes:type:template or I@qubes:type:standalone) and (G@kernel:Linux or G@kernel:*BSD)':
    - match: compound
    - sys-net.install-proxy
