base:
  'dom0':
    - match: nodegroup
    - personal-dev.create
  'tpl-personal-dev':
    - personal-dev.install
  'dvm-personal-dev':
    - personal-dev.configure-dvm
  'personal-dev':
    - personal-dev.configure
  '(I@qubes:type:template or I@qubes:type:standalone) and (G@kernel:Linux or G@kernel:*BSD)':
    - match: compound
    - sys-net.install-proxy
